{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "helpers:pinGitHubActionDigestsToSemver",
    "customManagers:biomeVersions"
  ],
  "schedule": ["* 8-23 * * 0,6"],
  "labels": ["dependencies"],
  "assignees": ["jaanjah"],
  "reviewers": ["jaanjah"],
  "packageRules": [
    {
      "description": "Update the Biome package and the biome.json $schema together",
      "matchPackageNames": ["@biomejs/biome"],
      "groupName": "Biome"
    },
    {
      "description": "Update the Bun runtime and its type definitions together",
      "matchPackageNames": ["bun", "@types/bun"],
      "groupName": "Bun"
    }
  ]
}
