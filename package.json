{
  "name": "typescript-template",
  "version": "1.0.0",
  "description": "Template repository to start off a TypeScript project",
  "type": "module",
  "module": "src/main.ts",
  "engines": {
    "bun": ">=1.3"
  },
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "build": "bun build src/main.ts --outdir build --target bun --minify",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "biome check && bun run typecheck",
    "fix": "biome check --write",
    "format": "biome format --write",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JaanJah/typescript-template.git"
  },
  "author": "JaanJah",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/JaanJah/typescript-template/issues"
  },
  "homepage": "https://github.com/JaanJah/typescript-template#readme",
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@types/bun": "^1.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "typescript": "^6.0.0"
  }
}
